datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Todo {
  id          String  @id @default(uuid()) // or Int @id @default(autoincrement())
  title       String
  description String?
  date        String?

  @@map("todo")
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)

  @@map("product")
}
